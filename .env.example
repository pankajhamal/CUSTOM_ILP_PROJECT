# ---------------------------------------------------------------------------
# Custom ILP ASE — Environment Template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Custom ILP ASE"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Database (async SQLAlchemy / asyncpg) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://ilp:ilp@localhost:5432/ilp_ase
# Connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Security: password hashing & app secret ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Rafiki Webhook security (HMAC-SHA256), inbound Rafiki -> ASE ---
# Same variable NAME as the Rafiki testnet local/.env, so the shared secret is
# identical on both sides. (Legacy name RAFIKI_WEBHOOK_SECRET is also accepted.)
RAFIKI_SIGNATURE_SECRET=change-me-shared-with-rafiki
# Header Rafiki sends the signature in, and the signature version prefix.
# NOTE: confirm Rafiki's actual header (it uses "signature") before webhook tests.
RAFIKI_WEBHOOK_SIGNATURE_HEADER=x-signature
RAFIKI_WEBHOOK_SIGNATURE_VERSION=1
# Reject webhooks whose timestamp is older than this (seconds) to limit replay.
RAFIKI_WEBHOOK_TOLERANCE_SECONDS=300

# --- Rafiki Admin API (GraphQL), outbound ASE -> Rafiki ---
# These share the exact variable names used in the Rafiki testnet local/.env.
# (Legacy names RAFIKI_GRAPHQL_SIGNATURE_SECRET / _VERSION / RAFIKI_TENANT_ID
# are also accepted.)
# Cloud Nine Wallet testnet backend is :3001; Happy Life Bank is :4001.
RAFIKI_GRAPHQL_URL=http://localhost:3001/graphql
ADMIN_API_SECRET=
ADMIN_SIGNATURE_VERSION=1
OPERATOR_TENANT_ID=
RAFIKI_HTTP_TIMEOUT_SECONDS=30

# --- Default asset for provisioning (Open Payments integer amounts) ---
# assetScale 2 => amounts are in cents (1000 == 10.00). assetScale 9 => nano.
DEFAULT_ASSET_ID=
DEFAULT_ASSET_CODE=USD
DEFAULT_ASSET_SCALE=2

# --- Wallet address base (public payment pointer host) ---
WALLET_ADDRESS_BASE_URL=https://wallet.example

# --- OpenTelemetry ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=custom-ilp-ase
# OTLP gRPC endpoint (e.g. Jaeger / collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
